<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately a plain console app, not an xUnit/NUnit/MSTest project: this sandbox/CI has no
    access to nuget.org (see docs/README.md), and the library itself ships with zero NuGet
    dependencies, so the test runner follows the same constraint - it is a small self-contained
    "assert or throw" program, run with `dotnet run`, that exits non-zero on the first failure.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DacteNet.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DacteNet\DacteNet.csproj" />
  </ItemGroup>

</Project>
